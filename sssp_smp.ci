mainmodule sssp_smp
{
  extern module htram_group;
  readonly CProxy_Main mainProxy;
  readonly CProxy_SsspChares arr;
  readonly CProxy_SharedInfo shared;
  readonly int N;
  readonly long V;
  readonly int M;
  readonly long average_degree;
  readonly int S;
  readonly long num_global_edges;
  readonly int generate_mode;
  readonly cost lmax;
  readonly int buffer_size;
  readonly int initial_threshold;
  readonly bool verify_mode;
  readonly int process_share_mode;
  readonly long reader_tile_size;
  readonly int reader_tile_owners;
  readonly int flush_round_interval;
  readonly int flush_policy;
  readonly int idle_flush_policy;
  readonly int bucket_policy;
  readonly int bucket_target;
  readonly int two_tier_per_pe;
  readonly long two_tier_absolute;
  readonly int coarsen_clamp_policy;
  readonly int bucket_width_rule;
  readonly bool clamp_freeze;
  readonly bool range_extend;
  readonly bool skew_defer;
  readonly bool pq_overflow_last;
  readonly int window_follow;
  readonly int combine_mode;
  readonly bool batch_fold;
  readonly int send_filter_bits;
  readonly bool send_filter_auto;
  readonly double idle_flush_interval_us;
  readonly long lazy_cut;
  readonly bool warm_links_on;
  readonly int lazy_growth;
  readonly int skip_empty_mode;
  readonly double degree_cv;
  readonly double lazy_skew_min;
  readonly int control_mode;
  readonly double control_interval_ms;
  readonly CProxy_ControlNode controlProxy;
  readonly int bufsize_policy;
  readonly double bufsize_acc_items;
  readonly int bufsize_min;
  readonly int bufsize_max;
  readonly int partition_jitter_percent;
  readonly double timeout_seconds;
  readonly double reduction_delay;
  readonly double bucket_width_override;
  readonly double round_delay_ms;
  readonly double flush_timer;
  readonly bool enable_buffer_flushing;
  readonly CProxy_HTram tram_proxy;
  mainchare Main
  {
    entry Main(CkArgMsg* m);
    entry [reductiontarget] void begin(cost max_edge_weight); //every chare holds its partition and the graph's heaviest edge is known: seed the bucket width, then start
    entry [reductiontarget] void width_seeded(); //every chare is binning at the seeded width
    entry void start_source(); // --warm-links: called again at quiescence
    entry void advance_source(); // quiescence before resetting retained graph state
    entry [reductiontarget] void source_reset_done();
    entry void rmat_edges_distributed(); // quiescence: every generated edge has reached its owner
    entry [reductiontarget, expedited] void reduce_histogram(long histo_values[N], int histo_length);
    entry [reductiontarget] void done(long msg_stats[N], int N); //bcast to chares to print results and end program
    entry [reductiontarget] void done_max_cost(cost max_cost);
    entry [reductiontarget] void done_verify(unsigned long long values[n], int n);
    entry [reductiontarget] void done_tram_stats(unsigned long long values[n], int n);
  };
  array [1D] SsspChares
  {
    entry SsspChares(CProxy_HTram htram);
    entry void initiate_pointers();
    entry [whenidle] bool idle_triggered();
    entry void generate_2d_graph(long partition[dividers], int dividers);
    entry void generate_local_graph(long _num_vertices, long _num_edges, long partition[dividers], int dividers);
    entry void get_graph(LongEdge edges[E], long E, long partition[dividers], int dividers); //gets graph partition
    entry void generate_rmat_graph(long partition[dividers], int dividers); // generate this PE's slice of the edge index space and route it
    entry void receive_edges(LongEdge edges[E], long E); // edges routed here by their generator
    entry void build_rmat_csr(); // all edges have arrived; build the rows
    entry void load_gapbs_graph(std::string path, long partition[dividers], int dividers); // read this PE's rows straight out of a .sg/.wsg file
    entry void start_papi();
    entry void reset_for_source();
    entry void seed_bucket_width(cost max_edge_weight); // --bucket-width-rule weight: bucket by distance, not by |V|
    entry void start_algo(Update new_vertex_and_distance);
    entry void process_heap();
    entry void warm_links(); // one message to a PE of every other process
    entry void warm_ping();
    entry void pickup_fallback(); // --control node: apply the round this process holds
    entry void process_update(Update new_vertex_and_distance); //receives an updated vertex num and distance, and calls this method on neighbor chares
    entry [expedited] void contribute_histogram(int behind_first_nonzero); //contributes histogram to main pe
    entry void clear_pq_hold();
    entry void report_progress_state(int tag); // one line per PE, on a stall
    entry void current_thresholds(int _heap_threshold, int _tram_threshold, int _bfs_threshold, int behind_first_nonzero, int phase, int starved, int coarsen, int extend, int buffer_size_now); // broadcast bucket limit
    entry void print_distances(); // print out the distances on each chare
    entry void stop_periodic_flush();
    entry void get_max_cost(); // get max cost as correctness check
    entry void verify_hash(); // fold local distances into a checksum
  };
  nodegroup ControlNode
  {
    entry ControlNode();
    entry void collect(int n, long values[n]);
    entry void thresholds(int gen, int heap, int tram, int bfs, int behind, int phase, int starved, int coarsen, int extend, int bufsize);
  };
  group SharedInfo
  {
    entry SharedInfo();
  };

};
