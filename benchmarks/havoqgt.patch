-    if (!is_finalized) {
-      MPI_Finalize();
-    }
-  }
+  // Mains call MPI_Finalize themselves before returning. Reaching this
+  // destructor unfinalized means exit() from inside MPI_Abort (Cray PMI2_Abort
+  // calls exit), where MPI_Finalize waits in a barrier for ranks that already
