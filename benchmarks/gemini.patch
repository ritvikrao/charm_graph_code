+  void discover_topology() {
+    assert( numa_available() != -1 );
+    std::vector<int> allowed;
+    int places = omp_get_num_places();
+    if (places > 0) {
+      for (int p=0;p<places;p++) {
+        std::vector<int> ids(omp_get_place_num_procs(p));
+        omp_get_place_proc_ids(p, ids.data());
+        allowed.insert(allowed.end(), ids.begin(), ids.end());
+      }
+    } else {
+      cpu_set_t mask;
+      CPU_ZERO(&mask);
+      int rc = sched_getaffinity(0, sizeof(mask), &mask);
+      assert(rc==0);
+      for (int c=0;c<CPU_SETSIZE;c++) {
+        if (CPU_ISSET(c, &mask)) allowed.push_back(c);
+      }
+    }
+    std::sort(allowed.begin(), allowed.end());
+    allowed.erase(std::unique(allowed.begin(), allowed.end()), allowed.end());
+    std::vector<std::vector<int>> by_node(numa_max_node()+1);
+    for (int c : allowed) {
+      int node = numa_node_of_cpu(c);
+      assert(node >= 0 && node < (int)by_node.size());
+      by_node[node].push_back(c);
+    }
+    for (size_t n=0;n<by_node.size();n++) {
+      if (!by_node[n].empty()) {
+        socket_nodes.push_back((int)n);
+        socket_cpus.push_back(by_node[n]);
+      }
+    }
+    sockets = socket_nodes.size();
+    assert(sockets > 0);
+    size_t fewest = socket_cpus[0].size();
+    for (auto & cpus : socket_cpus) fewest = std::min(fewest, cpus.size());
+    threads_per_socket = (int)fewest;
+    const char * env_tps = getenv("GEMINI_THREADS_PER_SOCKET");
+    const char * env_omp = getenv("OMP_NUM_THREADS");
+    if (env_tps != nullptr && atoi(env_tps) > 0) {
+      threads_per_socket = atoi(env_tps);
+    } else if (env_omp != nullptr && atoi(env_omp) > 0) {
+      int total = atoi(env_omp);
+      if (total % sockets != 0) {
+        fprintf(stderr, "gemini: OMP_NUM_THREADS=%d is not a multiple of the %d NUMA nodes this rank may run on\n", total, sockets);
+        abort();
+      }
+      threads_per_socket = total / sockets;
+    }
+    threads = sockets * threads_per_socket;
+  }
